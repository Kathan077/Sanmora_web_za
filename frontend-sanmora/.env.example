# -------------------------------------------------------------
# SANMORA WEB - ENVIRONMENT CONFIGURATION TEMPLATE
# -------------------------------------------------------------

# 1. OPTIONAL: External Backend API URL (Leave blank if Next.js handles API routes on same domain)
# NEXT_PUBLIC_API_URL=https://sanmora-web-za-oths.vercel.app

# 2. Hostinger SMTP Mailer Credentials
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=info@sanmora.in
EMAIL_PASS=""
EMAIL_RECEIVER=info@sanmora.in, info@sanmora.co.za

# 3. Google reCAPTCHA v3 Configuration (Required for spam & bot protection)
# Generate from https://www.google.com/recaptcha/admin (Select reCAPTCHA v3)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_v3_site_key
RECAPTCHA_SECRET_KEY=your_recaptcha_v3_secret_key
RECAPTCHA_MIN_SCORE=0.5

# 4. Google Gemini AI API Configuration (Official @google/genai SDK)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# 5. OPTIONAL: HTTP MAILER API KEYS (Alternative to SMTP)
# RESEND_API_KEY=re_123456789
# RESEND_FROM="Sanmora Consultation <contact@sanmora.in>"
# SENDGRID_API_KEY=SG.123456789
